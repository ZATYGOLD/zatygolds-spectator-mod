<Database>
	<EnglishText>
		<Row Tag="LOC_LEADER_ZOM_OBSERVER_NAME">
			<Text>Spectator</Text>
		</Row>
		<Row Tag="LOC_LEADER_ZOM_OBSERVER_DESCRIPTION">
			<Text>Watch the game without playing. The Spectator has no abilities, founds no settlement and sees the whole map. Its civilization is the Observers.</Text>
		</Row>
		<Row Tag="LOC_LEADER_ZOM_OBSERVER_QUOTE">
			<Text>"To see everything, hold nothing."</Text>
		</Row>
		<Row Tag="LOC_TRAIT_ZOM_OBSERVER_LEADER_NAME">
			<Text>All-Seeing</Text>
		</Row>
		<Row Tag="LOC_TRAIT_ZOM_OBSERVER_LEADER_DESCRIPTION">
			<Text>Never eliminated for having no settlements.</Text>
		</Row>
	</EnglishText>
</Database>
