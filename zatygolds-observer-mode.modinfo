<?xml version="1.0" encoding="utf-8"?>
<Mod id="zatygolds-observer-mode" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_ZOM_NAME</Name>
        <Description>LOC_MOD_ZOM_DESCRIPTION</Description>
        <Authors>Zatygold</Authors>
        <SpecialThanks>LOC_MOD_ZOM_SPECIAL_THANKS</SpecialThanks>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
        <Version>1.0.0</Version>
        <LastUpdated>2026-10-04</LastUpdated>
        <ShowInBrowser>1</ShowInBrowser>
    </Properties>

    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
        <Mod id="age-antiquity" title="LOC_MODULE_AGE_ANTIQUITY_NAME"/>
        <Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME"/>
        <Mod id="age-modern" title="LOC_MODULE_AGE_MODERN_NAME"/>
    </Dependencies>

    <ActionCriteria>
        <Criteria id="always"><AlwaysMet/></Criteria>

        <!-- A game with a Spectator: the hidden game option set at setup while any
             player is the Spectator (ui/setup/setup-observer.js). -->
        <Criteria id="zom-observer-in-game">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>ZOM_OBSERVER_IN_GAME</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
    </ActionCriteria>

    <ActionGroups>
<!--*************************** SHELL: SETUP & LOBBY ***************************************************-->

        <ActionGroup id="zom-shell" scope="shell" criteria="always">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ConfigText.xml</Item>
                    <Item>text/en_us/LeaderText.xml</Item>
                    <Item>text/en_us/CivilizationText.xml</Item>
                    <Item>text/en_us/UnitText.xml</Item>
                    <Item>text/en_us/LoadingText.xml</Item>
                    <Item>text/en_us/UnlockText.xml</Item>
                    <Item>text/en_us/UIText.xml</Item>
                    <Item locale="de_DE">l10n/de_DE_Text.xml</Item>
                    <Item locale="es_ES">l10n/es_ES_Text.xml</Item>
                    <Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
                    <Item locale="it_IT">l10n/it_IT_Text.xml</Item>
                    <Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
                    <Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
                    <Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
                    <Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
                    <Item locale="ru_RU">l10n/ru_RU_Text.xml</Item>
                    <Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
                    <Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>
                </UpdateText>
                <UpdateDatabase>
                    <Item>config/setup-parameters.sql</Item>
                    <Item>config/config.xml</Item>
                    <Item>config/setup-rules.sql</Item>
                </UpdateDatabase>
                <ImportFiles>
                    <Item>art/icons/zom_observer.png</Item>
                    <Item>art/icons/zom_observer_civ.png</Item>
                    <Item>art/icons/zom_observer_leader_256.png</Item>
                    <Item>art/icons/zom_observer_leader_128.png</Item>
                    <Item>art/icons/zom_observer_leader_64.png</Item>
                    <Item>art/icons/zom_observer_circle_256.png</Item>
                    <Item>art/icons/zom_observer_circle_128.png</Item>
                    <Item>art/icons/zom_observer_circle_64.png</Item>
                    <Item>art/icons/zom_observer_portrait_140.png</Item>
                    <Item>art/leaders/lsl_zom_observer.png</Item>
                    <Item>art/backgrounds/cg_zom_observer_vert.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/icons/icons.xml</Item>
                </UpdateIcons>
                <UpdateColors>
                    <Item>data/colors/playercolors.xml</Item>
                </UpdateColors>
                <UIScripts>
                    <Item>ui/shared/zom-util.js</Item>
                    <Item>ui/shared/zom-assets.js</Item>
                    <Item>ui/setup/setup-config.js</Item>
                    <Item>ui/setup/setup-observer.js</Item>
                    <Item>ui/setup/lobby-observer.js</Item>
                    <Item>ui/setup/create-game-observer.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--*************************** GAME: SPECTATOR LEADER, CIVILIZATIONS & UI *****************************-->

        <ActionGroup id="zom-game" scope="game" criteria="always">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ConfigText.xml</Item>
                    <Item>text/en_us/LeaderText.xml</Item>
                    <Item>text/en_us/CivilizationText.xml</Item>
                    <Item>text/en_us/UnitText.xml</Item>
                    <Item>text/en_us/LoadingText.xml</Item>
                    <Item>text/en_us/UnlockText.xml</Item>
                    <Item>text/en_us/UIText.xml</Item>
                    <Item locale="de_DE">l10n/de_DE_Text.xml</Item>
                    <Item locale="es_ES">l10n/es_ES_Text.xml</Item>
                    <Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
                    <Item locale="it_IT">l10n/it_IT_Text.xml</Item>
                    <Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
                    <Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
                    <Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
                    <Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
                    <Item locale="ru_RU">l10n/ru_RU_Text.xml</Item>
                    <Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
                    <Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>
                </UpdateText>
                <UpdateDatabase>
                    <Item>data/leaders.xml</Item>
                    <Item>data/civilizations.xml</Item>
                    <Item>data/units-gameeffects.xml</Item>
                    <Item>data/units.xml</Item>
                    <Item>data/legacies.sql</Item>
                    <Item>data/loading-info.xml</Item>
                </UpdateDatabase>
                <ImportFiles>
                    <Item>maps/zom-observer-eye.js</Item>
                    <Item>art/icons/zom_observer.png</Item>
                    <Item>art/icons/zom_observer_civ.png</Item>
                    <Item>art/icons/zom_observer_leader_256.png</Item>
                    <Item>art/icons/zom_observer_leader_128.png</Item>
                    <Item>art/icons/zom_observer_leader_64.png</Item>
                    <Item>art/icons/zom_observer_circle_256.png</Item>
                    <Item>art/icons/zom_observer_circle_128.png</Item>
                    <Item>art/icons/zom_observer_circle_64.png</Item>
                    <Item>art/icons/zom_observer_portrait_140.png</Item>
                    <Item>art/backgrounds/cg_zom_observer_vert.png</Item>
                    <Item>art/backgrounds/lsbg_zom_observer_1080.png</Item>
                    <Item>art/backgrounds/lsbg_zom_observer_720.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/icons/icons.xml</Item>
                </UpdateIcons>
                <UpdateColors>
                    <Item>data/colors/playercolors.xml</Item>
                </UpdateColors>
                <UIScripts>
                    <Item>ui/shared/zom-util.js</Item>
                    <Item>ui/shared/zom-assets.js</Item>
                    <Item>ui/observer/observer-config.js</Item>
                    <Item>ui/observer/observer-core.js</Item>
                    <Item>ui/observer/observer-faith.js</Item>
                    <Item>ui/observer/observer-overview.js</Item>
                    <Item>ui/observer/observer-screens.js</Item>
                    <Item>ui/observer/observer-leader-view.js</Item>
                    <Item>ui/observer/observer-leader-screens.js</Item>
                    <Item>ui/observer/observer-civ-lists.js</Item>
                    <Item>ui/observer/observer-ribbon-data.js</Item>
                    <Item>ui/observer/observer-ribbon-style.js</Item>
                    <Item>ui/observer/observer-history.js</Item>
                    <Item>ui/observer/observer-graphs.js</Item>
                    <Item>ui/observer/observer-turn.js</Item>
                    <Item>ui/observer/observer-settlement-info.js</Item>
                    <Item>ui/observer/observer-perspective.js</Item>
                    <Item>ui/observer/observer-banners.js</Item>
                    <Item>ui/observer/observer-ribbon-toolbar.js</Item>
                    <Item>ui/observer/observer-ribbon.js</Item>
                    <Item>ui/observer/observer-settlement.js</Item>
                    <Item>ui/observer/observer-navigation.js</Item>
                    <Item>ui/observer/observer-victory.js</Item>
                    <Item>ui/observer/observer-diplomacy.js</Item>
                    <Item>ui/observer/observer-yields.js</Item>
                    <Item>ui/observer/observer-hud.js</Item>
                    <Item>ui/observer/observer-units.js</Item>
                    <Item>ui/observer/observer-combat.js</Item>
                    <Item>ui/observer/observer-eye.js</Item>
                    <Item>ui/observer/observer-prompts.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--*************************** GAME: BASE-GAME OVERRIDES **********************************************-->

        <!-- Copies of base-game files (changes marked "ZOM:"), loaded only in a game
             with a Spectator: every other game runs the untouched files, or another
             mod's versions of them. LoadOrder 1100 lets these win over other mods'
             copies in this mod's games. -->
        <ActionGroup id="zom-game-overrides" scope="game" criteria="zom-observer-in-game">
            <Properties><LoadOrder>1100</LoadOrder></Properties>
            <Actions>
                <ImportFiles>
                    <Item>maps/map-globals.js</Item>
                    <Item>scripts/age-transition-post-load.js</Item>
                    <Item>ui-next/screens/victories/victories-screen-model.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-model.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-empire-tab.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-trade-tab.js</Item>
                    <Item>ui-next/screens/legacies/legacies-screen.js</Item>
                    <Item>ui-next/screens/legacies/legacies-model.js</Item>
                    <Item>ui-next/screens/legacies/dedications-model.js</Item>
                    <Item>ui/policies/government-hub.js</Item>
                    <Item>ui/policies/model-government.js</Item>
                    <Item>ui/policies/model-policies.js</Item>
                    <Item>ui/policies/policies-support.js</Item>
                    <Item>ui/great-works/model-great-works.js</Item>
                    <Item>ui/tech-tree/model-tech-tree.js</Item>
                    <Item>ui/culture-tree/model-culture-tree.js</Item>
                    <Item>ui/tree-grid/tree-grid.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
    </ActionGroups>

    <LocalizedText>
        <File>text/en_us/ModuleText.xml</File>
        <File>l10n/ModuleText.xml</File>
    </LocalizedText>
</Mod>
