		</Replace>
		<Replace Tag="LOC_UNLOCK_PLAY_AS_ZOM_OBSERVER_TOOLTIP" Language="fr_FR">
			<Text>Le [B]Spectateur[/B] observe en tant que [B]Observateurs[/B] à chaque Âge.</Text>
		</Replace>
