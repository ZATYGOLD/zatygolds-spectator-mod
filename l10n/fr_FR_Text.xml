		<Replace Tag="LOC_LEADER_ZOM_OBSERVER_NAME" Language="fr_FR">
			<Text>Spectateur</Text>
		</Replace>
		<Replace Tag="LOC_LEADER_ZOM_OBSERVER_DESCRIPTION" Language="fr_FR">
			<Text>Regardez la partie sans jouer. Le Spectateur n'a aucune capacité, ne fonde aucune colonie et voit toute la carte. À associer à la civilisation Spectateur.</Text>
		</Replace>
		<Replace Tag="LOC_LEADER_ZOM_OBSERVER_QUOTE" Language="fr_FR">
			<Text>« Pour tout voir, ne rien retenir. »</Text>
		</Replace>
		<Replace Tag="LOC_TRAIT_ZOM_OBSERVER_LEADER_NAME" Language="fr_FR">
			<Text>Omnivoyant</Text>
		</Replace>
		<Replace Tag="LOC_TRAIT_ZOM_OBSERVER_LEADER_DESCRIPTION" Language="fr_FR">
			<Text>N'est jamais éliminé faute de colonies.</Text>
		</Replace>
		<Replace Tag="LOC_CIVILIZATION_ZOM_OBSERVER_NAME" Language="fr_FR">
