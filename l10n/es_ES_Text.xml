		<Replace Tag="LOC_ZOM_OBSERVER_IN_GAME" Language="es_ES">
			<Text>Espectador en la partida</Text>
		</Replace>
		<Replace Tag="LOC_LEADER_ZOM_OBSERVER_NAME" Language="es_ES">
			<Text>Espectador</Text>
		</Replace>
		<Replace Tag="LOC_LEADER_ZOM_OBSERVER_DESCRIPTION" Language="es_ES">
			<Text>Observa la partida sin jugar. El Espectador no tiene habilidades, no funda ningún asentamiento y ve todo el mapa. Su civilización son los Observadores.</Text>
		</Replace>
		<Replace Tag="LOC_LEADER_ZOM_OBSERVER_QUOTE" Language="es_ES">
			<Text>«Para verlo todo, no hay que aferrarse a nada».</Text>
		</Replace>
		<Replace Tag="LOC_TRAIT_ZOM_OBSERVER_LEADER_NAME" Language="es_ES">
			<Text>Omnividente</Text>
		</Replace>
		<Replace Tag="LOC_TRAIT_ZOM_OBSERVER_LEADER_DESCRIPTION" Language="es_ES">
			<Text>Nunca es eliminado por no tener asentamientos.</Text>
		</Replace>
		<Replace Tag="LOC_CIVILIZATION_ZOM_OBSERVER_NAME" Language="es_ES">
			<Text>Observadores</Text>
		</Replace>
